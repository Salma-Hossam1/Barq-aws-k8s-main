
[k8s_nodes:children]
control_plane
workers

[control_plane]
control-1 ansible_host=REPLACE_WITH_CONTROL_PUBLIC_IP ansible_private_ip=REPLACE_WITH_CONTROL_PRIVATE_IP ansible_user=ubuntu ansible_ssh_private_key_file=/ABSOLUTE/PATH/TO/YOUR-EC2-KEY.pem

[workers]
worker-1 ansible_host=REPLACE_WITH_WORKER_PUBLIC_IP ansible_private_ip=REPLACE_WITH_WORKER_PRIVATE_IP ansible_user=ubuntu ansible_ssh_private_key_file=/ABSOLUTE/PATH/TO/YOUR-EC2-KEY.pem
